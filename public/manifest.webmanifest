{
    "name": "ServerScope",
    "short_name": "ServerScope",
    "description": "Server and website monitoring",
    "id": "/dashboard",
    "start_url": "/dashboard?source=app",
    "scope": "/",
    "display": "standalone",
    "background_color": "#0a0a0b",
    "theme_color": "#0a0a0b",
    "icons": [
        { "src": "/app-icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
        { "src": "/app-icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
        { "src": "/app-icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
    ],
    "shortcuts": [
        { "name": "Incidents", "url": "/incidents", "icons": [{ "src": "/app-icons/icon-192.png", "sizes": "192x192" }] },
        { "name": "Servers", "url": "/servers", "icons": [{ "src": "/app-icons/icon-192.png", "sizes": "192x192" }] }
    ]
}
